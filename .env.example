# ---- OPTIONAL: leave blank to run fully offline (no keys needed) ----
# OpenAI -> LLM-written answers + smarter entity extraction
# Neo4j  -> external graph database (otherwise a local SQLite graph is used)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Free local AI answers (no key): install Ollama from https://ollama.com,
# run `ollama pull llama3.2`, then set:
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434

# ---- Security ----
# First admin account, created on first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=S@nthosh
# Token signing key. If empty, one is generated and stored in data/.secret_key
SECRET_KEY=
# Let anyone create an account from the login page (admin can toggle later)
ALLOW_SIGNUP=false
TOKEN_EXPIRE_MINUTES=480
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Storage ----
MAX_FILE_SIZE_MB=50
DEFAULT_USER_QUOTA_MB=500

# ---- Production hosting (docker-compose.prod.yml) ----
DOMAIN=aksanintelligency.sbs
